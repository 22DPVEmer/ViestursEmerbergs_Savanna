@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome to Savanna";
}

<link rel="stylesheet" href="~/css/savanna-theme.css" />

<div class="auth-container" style="max-width: 800px;">
    <div class="text-center">
        <h1 class="auth-title display-4 mb-4">Welcome to Savanna Game</h1>
        <div class="auth-emoji mb-4">
            🦁 🦓 🦒 🐘 🦊 🦛
        </div>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <p class="auth-subtitle mb-4">Welcome back! Head to your dashboard to continue your adventure.</p>
                    <a class="btn btn-lg btn-primary" asp-page="/Dashboard">Go to Dashboard</a>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <p class="auth-subtitle mb-4">
                        Experience the thrill of managing your own savanna ecosystem! Create and manage your virtual savanna,
                        watch animals interact, and make strategic decisions to maintain the balance of nature.
                    </p>
                    
                    <div class="d-grid gap-3 col-md-6 mx-auto">
                        <a class="btn btn-lg btn-primary" asp-area="Identity" asp-page="/Account/Register">Register Now</a>
                        <a class="btn btn-lg btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    </div>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-md-4 mb-4">
                    <div class="feature-card">
                        <div class="feature-emoji">🦒</div>
                        <h3>Manage Your Savanna</h3>
                        <p>Create and customize your own virtual savanna ecosystem with various animals and environments.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-card">
                        <div class="feature-emoji">📊</div>
                        <h3>Track Progress</h3>
                        <p>Monitor your ecosystem's health, track animal populations, and view detailed statistics.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-card">
                        <div class="feature-emoji">💾</div>
                        <h3>Save & Resume</h3>
                        <p>Save your progress at any time and continue your savanna management journey later.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
.feature-card {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 15px;
    padding: 1.5rem;
    height: 100%;
    transition: transform 0.2s;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.feature-card:hover {
    transform: translateY(-5px);
}

.feature-emoji {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    text-align: center;
}

.feature-card h3 {
    color: var(--savanna-brown);
    text-align: center;
    margin-bottom: 1rem;
}

.feature-card p {
    color: #666;
    text-align: center;
    margin-bottom: 0;
}
</style>
